{
  "name": "nenpyo-net",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "start": "vite dev",
    "prepare": "svelte-kit sync",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:d1": "vitest run --project d1",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply nenpyo --local",
    "db:migrate": "wrangler d1 migrations apply nenpyo --remote",
    "data:convert": "node scripts/convert-lifeline.mjs",
    "data:check": "node scripts/check-curation.mjs",
    "data:propose-taglines": "node scripts/propose-taglines.mjs",
    "data:import:local": "wrangler d1 execute nenpyo --local --file=data/sf-tech-lifeline.sql",
    "data:import": "wrangler d1 execute nenpyo --remote --file=data/sf-tech-lifeline.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.42.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
