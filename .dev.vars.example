# GitHub OAuth App の資格情報。.dev.vars にコピーして使う（.dev.vars は commit しない）。
#
# 開発用のアプリを別途登録すること。GitHub の OAuth App は
# コールバック URL を 1 つしか持てないため。
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/auth/github/callback
#
# スコープは要求しない（公開プロフィールだけで足りる）。

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
